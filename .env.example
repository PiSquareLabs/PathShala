# Agent provider: simulated (default, deterministic, no network) | gemini (not implemented yet, see src/agent/provider.js)
VITE_AGENT_PROVIDER=simulated
# Only used when provider = gemini: the server proxy that holds the Gemini key
VITE_AGENT_ENDPOINT=/api/agent
# Animation delay between simulated agent steps, in milliseconds
VITE_AGENT_STEP_DELAY_MS=420
