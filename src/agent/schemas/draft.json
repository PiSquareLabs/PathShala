{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathshala.local/schemas/draft.json",
  "title": "Draft",
  "type": "object",
  "required": [
    "sentences"
  ],
  "properties": {
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
