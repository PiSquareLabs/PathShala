{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathshala.local/schemas/critique.json",
  "title": "Critique",
  "type": "object",
  "required": [
    "pass",
    "issues"
  ],
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sentence_index",
          "problem",
          "fix"
        ],
        "properties": {
          "sentence_index": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  }
}
