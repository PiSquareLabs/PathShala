{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathshala.local/schemas/findings.json",
  "title": "Findings",
  "type": "object",
  "required": [
    "findings",
    "gaps"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fid",
          "title",
          "kind",
          "severity",
          "summary",
          "status",
          "evidence"
        ],
        "properties": {
          "fid": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "primary",
              "secondary",
              "context"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "evidence.json"
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
