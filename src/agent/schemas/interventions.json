{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathshala.local/schemas/interventions.json",
  "title": "Interventions",
  "type": "object",
  "required": [
    "interventions"
  ],
  "properties": {
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "title",
          "chunk_ids",
          "interpretation",
          "evidence_refs",
          "cost"
        ],
        "properties": {
          "code": {
            "enum": [
              "TR",
              "ES",
              "SEA",
              "RET"
            ]
          },
          "title": {
            "type": "string"
          },
          "chunk_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C[0-9]+$"
            }
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cost": {
            "$ref": "cost_calc_output.json"
          }
        }
      }
    }
  }
}
